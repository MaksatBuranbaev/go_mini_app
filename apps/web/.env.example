# Скопируйте в .env.local (он в .gitignore) или задайте переменными окружения
# при сборке. Секретов здесь нет и быть не может: всё уезжает в бандл.

# Адрес своего воркера-комнаты. Обязателен для прод-сборки; в dev по умолчанию
# берётся локальный `wrangler dev` на http://localhost:8787.
VITE_ROOM_URL=https://go-room.<ваш-поддомен>.workers.dev

# Ссылка на свой мини-апп: к ней дописывается id комнаты как startapp.
VITE_MINIAPP_LINK=https://t.me/<бот>/<приложение>
